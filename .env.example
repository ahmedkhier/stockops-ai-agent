# LLM Provider Configuration (Use Gemini OR OpenRouter)
# Option A: Google Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option B: OpenRouter API (supports sk-or-v1-... keys and vision models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

PRICE_SPIKE_THRESHOLD_PCT=15.0
MIN_CONFIDENCE_SCORE=0.85
ALERT_WEBHOOK_URL=http://n8n:5678/webhook/invoice-anomaly
SQLITE_DB_PATH=data/inventory.db

